{
  "id": "adam_shiftlights",
  "title": "Shift Lights",
  "description": "RPM shift lights on the instrument cluster and HUD, with per-drive-mode thresholds and a cold-engine limit",
  "version": "0.2.0",
  "vendor": "custom",
  "loggingId": "OAD1",
  "iconGlyph": "rpm",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Shift Lights",
      "buttons": [
        ["BTN_DISPLAY", "Show on"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "enabled", "label": "Shift lights on", "type": "bool", "default": true},
    {"key": "display", "label": "Show on", "type": "choice", "default": "off",
     "options": [["off", "Off"], ["cluster", "Cluster"], ["hud", "HUD"], ["both", "Cluster + HUD"]]},
    {"key": "clusterStyle", "label": "Cluster: style", "type": "choice", "default": "large",
     "options": [["large", "M slats large"], ["classic", "M slats classic"], ["row", "Row v3"], ["stock", "Stock blocks"], ["off", "Off"]]},
    {"key": "hudStyle", "label": "HUD: style", "type": "choice", "default": "large",
     "options": [["large", "Bar + bracket large"], ["classic", "Bar + bracket classic"], ["bar", "Bar only"], ["bracket", "Bracket + gear only"], ["off", "Off"]]},
    {"key": "clusterSize", "label": "Cluster: size", "type": "number", "unit": "%", "default": 100, "markDefault": true, "steps": [70, 80, 90, 100, 110, 120]},
    {"key": "clusterBright", "label": "Cluster: brightness", "type": "number", "unit": "%", "default": 100, "markDefault": true, "steps": [20, 40, 60, 80, 100]},
    {"key": "clusterNight", "label": "Cluster: night dim", "type": "bool", "default": false},
    {"key": "hudSize", "label": "HUD: size", "type": "number", "unit": "%", "default": 100, "markDefault": true, "steps": [70, 80, 90, 100, 110, 120]},
    {"key": "hudBright", "label": "HUD: brightness", "type": "number", "unit": "%", "default": 100, "markDefault": true, "steps": [20, 40, 60, 80, 100]},
    {"key": "hudNight", "label": "HUD: night dim", "type": "bool", "default": false},
    {"key": "driveMode", "label": "Drive mode", "type": "choice", "default": "sport",
     "options": [["comfort", "Comfort"], ["sport", "Sport"], ["sportplus", "Sport+"]]},
    {"key": "comfortStart", "label": "Comfort: first light", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Default"},
     "steps": [0, 2000, 2500, 3000, 3500, 4000, 4500, 5000, 5500, 6000, 6200, 6500]},
    {"key": "comfortShift", "label": "Comfort: shift (red)", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Default"},
     "steps": [0, 2500, 3000, 3500, 4000, 4500, 5000, 5500, 6000, 6500, 6800, 6900]},
    {"key": "sportStart", "label": "Sport: first light", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Default"},
     "steps": [0, 2000, 2500, 3000, 3500, 4000, 4500, 5000, 5500, 6000, 6200, 6500]},
    {"key": "sportShift", "label": "Sport: shift (red)", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Default"},
     "steps": [0, 2500, 3000, 3500, 4000, 4500, 5000, 5500, 6000, 6500, 6800, 6900]},
    {"key": "sportplusStart", "label": "Sport+: first light", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Default"},
     "steps": [0, 2000, 2500, 3000, 3500, 4000, 4500, 5000, 5500, 6000, 6200, 6500]},
    {"key": "sportplusShift", "label": "Sport+: shift (red)", "type": "number", "unit": "rpm", "default": 0, "labels": {"0": "Default"},
     "steps": [0, 2500, 3000, 3500, 4000, 4500, 5000, 5500, 6000, 6500, 6800, 6900]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]}
  ]
}
